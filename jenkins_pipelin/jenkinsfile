pipeline {
    agent any
    stages {
        stage('Checkout') {
            steps {
                echo 'Checking out doce...'
            }
        }
        stage('Build') {
            steps {
                sh ./build.sh
            }
        }
        stage('Test') {
            steps {
                sh 'echo "Simulating test command"'
            }
        }
    }
}
// 3단계로 이루어짐  checkout , build, test
